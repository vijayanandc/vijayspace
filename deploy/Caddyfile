# Weft web: TLS (automatic for a public host name), the client's files with an SPA fallback, and the API.
# WEFT_SITE_ADDRESS: the public host name (e.g. flow.example.com; `:80` for plain HTTP behind another proxy).
# WEFT_API_UPSTREAMS: the API servers, space-separated (e.g. `weft-api:8080`); requests are balanced and an
# unhealthy server is skipped (GET /healthz).
# WEFT_LOGTO_ENDPOINT: the Logto tenant the browser talks to (allowed by the Content-Security-Policy).
{$WEFT_SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api/* /hooks/* /oauth/* /healthz /readyz
	handle @api {
		request_body {
			max_size 7MB
		}
		reverse_proxy {$WEFT_API_UPSTREAMS:weft-api:8080} {
			lb_policy round_robin
			lb_retries 2
			health_uri /healthz
			health_interval 10s
			fail_duration 30s
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html
		header @shell Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$WEFT_LOGTO_ENDPOINT}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' {$WEFT_LOGTO_ENDPOINT}"
		-Server
	}
}
